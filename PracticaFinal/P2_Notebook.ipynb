   "source": [
    "missingsPerColumn = sum.(ismissing.(x) for x in eachcol(data))\n",
    "topColumns = sortperm(missingsPerColumn, rev=true)[1:11]\n",
    "\n",
    "println.(names(data)[topColumns], \": \",missingsPerColumn[topColumns])\n",
    "\n",
    "plot(0:1033, length.(findall(x -> x==amount,missingsPerColumn) for amount in 0:1033))"
   ]
  },
